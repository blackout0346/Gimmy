<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HomeSeller.UserService</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotNetEnv" Version="3.2.0" />
      <PackageReference Include="MassTransit" Version="9.3.0" />
      <PackageReference Include="MassTransit.AspNetCore" Version="9.3.0" />
      <PackageReference Include="MassTransit.RabbitMQ" Version="9.3.0" />
      <PackageReference Include="MassTransit.Redis" Version="9.3.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
      <PackageReference Include="Microsoft.OpenApi" Version="3.11.1" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="StackExchange.Redis" Version="4.0.165-alpha" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    </ItemGroup>
  <Target Name="RemoveOpenApiSourceGenerator" BeforeTargets="CoreCompile">
      <ItemGroup>
        <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
      </ItemGroup>
    </Target>
</Project>
